#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D resultImage;

layout(push_constant) uniform Parameters
{
  float iTime;
};

// Расстояния до шара, кольца и плоскости.
float mapScene(vec3 p)
{
  float sphere = length(p) - 0.8;

  // Вращаем наклонённое кольцо вокруг вертикальной оси.
  float angle = 0.4;
  vec3 q = p;
  float rotation = iTime * 0.5;
  q.xz = mat2(cos(rotation), -sin(rotation),
              sin(rotation), cos(rotation)) * q.xz;
  q.xy = mat2(cos(angle), -sin(angle),
              sin(angle), cos(angle)) * q.xy;
  float ring = length(vec2(length(q.xz) - 1.25, q.y)) - 0.12;

  float floorDist = p.y + 1.1;
  return min(min(sphere, ring), floorDist);
}

// Идём вдоль луча на расстояние до ближайшей поверхности.
float rayMarch(vec3 origin, vec3 direction)
{
  float t = 0.0;
  for (int i = 0; i < 100; i++)
  {
    float d = mapScene(origin + direction * t);
    if (d < 0.001) return t;
    t += d;
    if (t > 30.0) break;
  }
  return -1.0;
}

// Нормаль — направление, в котором SDF растёт быстрее всего.
vec3 getNormal(vec3 p)
{
  vec2 e = vec2(0.001, 0.0);
  return normalize(vec3(
    mapScene(p + e.xyy) - mapScene(p - e.xyy),
    mapScene(p + e.yxy) - mapScene(p - e.yxy),
    mapScene(p + e.yyx) - mapScene(p - e.yyx)
  ));
}

void mainImage(out vec4 fragColor, in vec2 fragCoord)
{
  vec2 iResolution = vec2(imageSize(resultImage));
  vec2 uv = (2.0 * fragCoord - iResolution.xy) / iResolution.y;
  vec3 origin = vec3(0.0, 1.5, 4.5);
  vec3 forward = normalize(-origin);
  vec3 right = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));
  vec3 up = cross(right, forward);
  vec3 direction = normalize(uv.x * right + uv.y * up + 2.0 * forward);

  vec3 color = vec3(0.07, 0.10, 0.16);
  float t = rayMarch(origin, direction);

  if (t > 0.0)
  {
    vec3 p = origin + direction * t;
    vec3 normal = getNormal(p);
    vec3 lightPos = vec3(-3.0, 4.0, 3.0);
    vec3 lightDir = normalize(lightPos - p);

    vec3 material = vec3(0.95, 0.55, 0.18);
    if (length(p) < 0.81) material = vec3(0.15, 0.60, 0.75);
    if (p.y < -1.09) material = vec3(0.35, 0.38, 0.43);

    // Освещение Ламберта.
    float diffuse = max(dot(normal, lightDir), 0.0);

    // Второй луч проверяет, перекрыт ли путь к источнику света.
    float shadowHit = rayMarch(p + normal * 0.01, lightDir);
    float shadow = 1.0;
    if (shadowHit > 0.0 && shadowHit < length(lightPos - p))
      shadow = 0.0;

    // Блик по модели Фонга.
    float specular = pow(max(dot(reflect(-lightDir, normal), -direction), 0.0), 32.0);
    if (diffuse <= 0.0) specular = 0.0;
    color = material * (0.15 + diffuse * shadow) + vec3(0.3 * specular * shadow);
  }

  fragColor = vec4(pow(color, vec3(1.0 / 2.2)), 1.0);
}

void main()
{
  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  ivec2 resolution = imageSize(resultImage);
  if (any(greaterThanEqual(pixel, resolution)))
    return;

  // Shadertoy uses pixel centers and a bottom-left origin; Vulkan images start at the top.
  vec2 fragCoord = vec2(pixel.x, resolution.y - 1 - pixel.y) + vec2(0.5);
  vec4 color;
  mainImage(color, fragCoord);
  imageStore(resultImage, pixel, color);
}

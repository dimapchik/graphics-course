#version 450
#extension GL_GOOGLE_include_directive : require

#define METERING_ACCESS
#include "metering.glsl"

layout(local_size_x = METERING_TILE_WIDTH, local_size_y = METERING_TILE_HEIGHT) in;

layout(push_constant) uniform Parameters
{
    uint useSharedMemory;
} params;

shared uint groupMinimum;
shared uint groupMaximum;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    bool valid = all(lessThan(pixel, textureSize(hdrImage, 0)));

    // For nonnegative floats, the bit patterns sort in the same order as the values.
    uint bits = 0u;
    if (valid)
        bits = floatBitsToUint(luminance(texelFetch(hdrImage, pixel, 0).rgb));

    if (params.useSharedMemory == 0u)
    {
        if (valid)
        {
            atomicMin(metering.minimumBits, bits);
            atomicMax(metering.maximumBits, bits);
        }
        return;
    }

    if (gl_LocalInvocationIndex == 0u)
    {
        groupMinimum = 0xffffffffu;
        groupMaximum = 0u;
    }
    barrier();

    if (valid)
    {
        atomicMin(groupMinimum, bits);
        atomicMax(groupMaximum, bits);
    }
    barrier();

    if (gl_LocalInvocationIndex == 0u)
    {
        atomicMin(metering.minimumBits, groupMinimum);
        atomicMax(metering.maximumBits, groupMaximum);
    }
}
